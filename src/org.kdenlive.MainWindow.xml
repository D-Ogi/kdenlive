      <arg name="trackId" type="i" direction="out"/>
    </method>
    <method name="scriptInsertClip">
      <arg name="binClipId" type="s" direction="in"/>
      <arg name="trackId" type="i" direction="in"/>
      <arg name="position" type="i" direction="in"/>
      <arg name="clipId" type="i" direction="out"/>
    </method>
    <method name="scriptInsertClipsSequentially">
      <arg name="binClipIds" type="as" direction="in"/>
      <arg name="trackId" type="i" direction="in"/>
      <arg name="startPosition" type="i" direction="in"/>
