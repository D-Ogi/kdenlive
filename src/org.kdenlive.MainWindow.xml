    <method name="scriptAddToSelection">
      <arg name="itemId" type="i" direction="in"/>
      <arg name="clear" type="b" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptClearSelection">
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptSelectAll">
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptSelectCurrentTrack">
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptSelectItems">
      <arg name="trackIds" type="ai" direction="in"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.In0" value="QList&lt;int&gt;"/>
      <arg name="startFrame" type="i" direction="in"/>
      <arg name="endFrame" type="i" direction="in"/>
