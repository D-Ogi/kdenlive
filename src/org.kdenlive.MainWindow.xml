      <arg name="uuid" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>

    <!-- Zones (timeline in/out points) -->
    <method name="scriptGetZone">
      <arg name="zone" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>
    <method name="scriptSetZone">
      <arg name="inFrame" type="i" direction="in"/>
      <arg name="outFrame" type="i" direction="in"/>
      <arg name="success" type="b" direction="out"/>
