      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptSaveProject">
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptSaveProjectAs">
      <arg name="filePath" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptGetProjectName">
      <arg name="name" type="s" direction="out"/>
    </method>
    <method name="scriptGetProjectPath">
      <arg name="path" type="s" direction="out"/>
    </method>
    <method name="scriptGetProjectFps">
      <arg name="fps" type="d" direction="out"/>
