      <arg name="compoId" type="i" direction="in"/>
      <arg name="info" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>
    <method name="scriptMoveComposition">
      <arg name="compoId" type="i" direction="in"/>
      <arg name="trackId" type="i" direction="in"/>
      <arg name="position" type="i" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptResizeComposition">
      <arg name="compoId" type="i" direction="in"/>
      <arg name="newDuration" type="i" direction="in"/>
      <arg name="fromRight" type="b" direction="in"/>
      <arg name="resultDuration" type="i" direction="out"/>
    </method>
    <method name="scriptDeleteComposition">
      <arg name="compoId" type="i" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>
    <method name="scriptGetCompositionTypes">
      <arg name="types" type="av" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantList"/>
    </method>

    <!-- Effects -->
    <method name="scriptAddClipEffect">
      <arg name="clipId" type="i" direction="in"/>
      <arg name="effectId" type="s" direction="in"/>
