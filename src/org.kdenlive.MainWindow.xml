      <arg name="binId" type="s" direction="out"/>
    </method>
    <method name="scriptGetTitleXml">
      <arg name="binId" type="s" direction="in"/>
      <arg name="xml" type="s" direction="out"/>
    </method>
    <method name="scriptSetTitleXml">
      <arg name="binId" type="s" direction="in"/>
      <arg name="newXml" type="s" direction="in"/>
      <arg name="success" type="b" direction="out"/>
    </method>

    <!-- Timeline -->
    <method name="scriptGetTrackCount">
      <arg name="trackType" type="s" direction="in"/>
      <arg name="count" type="i" direction="out"/>
    </method>
    <method name="scriptGetTrackInfo">
      <arg name="trackIndex" type="i" direction="in"/>
      <arg name="info" type="a{sv}" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantMap"/>
    </method>
    <method name="scriptGetAllTracksInfo">
      <arg name="tracks" type="av" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantList"/>
