    <method name="scriptGetSubtitles">
      <arg name="subtitles" type="av" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariantList"/>
    </method>
    <method name="scriptAddSubtitle">
      <arg name="startFrame" type="i" direction="in"/>
